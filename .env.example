# Global
RUST_LOG=info

# PostgreSQL / Neon
DATABASE_URL=postgresql://user:password@localhost:5432/tempmail

# Redis / Queue
REDIS_URL=redis://127.0.0.1:6379
QUEUE_RAW_EMAIL_STREAM=email_raw
REDIS_CONSUMER_GROUP=email-processor
REDIS_STREAM_BLOCK_MS=5000

# Mailbox
MAILBOX_DOMAIN=example.com
MAILBOX_TTL_SECONDS=3600
MAILBOX_LOCAL_PART_LENGTH=12

# API Server
API_BIND_ADDR=0.0.0.0:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
SESSION_COOKIE_NAME=tempmail_session
SESSION_TTL_SECONDS=2592000
SESSION_COOKIE_SECURE=false
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT_MAX_REQUESTS=5
LOGIN_RATE_LIMIT_MAX_REQUESTS=10

# SMTP Receiver
SMTP_LISTEN_ADDR=0.0.0.0:2525
SMTP_HOSTNAME=localhost
SMTP_MAX_MESSAGE_BYTES=10485760
SMTP_MAX_MESSAGES_PER_CONNECTION=20
SMTP_RATE_LIMIT_WINDOW_SECONDS=60
SMTP_RATE_LIMIT_MESSAGES_PER_IP=30
SMTP_RATE_LIMIT_MESSAGES_PER_SENDER_DOMAIN=100
SMTP_ENABLE_STARTTLS=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# Email Processor
REDIS_CONSUMER_NAME=email-processor-1
EMAIL_PROCESSOR_BATCH_SIZE=10
MESSAGE_TTL_GRACE_SECONDS=300

# Cleanup Worker
CLEANUP_INTERVAL_SECONDS=60
CLEANUP_BATCH_SIZE=100
SOFT_DELETE_RETENTION_DAYS=30

# Cloudflare R2 / S3-compatible object storage
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PREFIX=attachments/
